{
  "name": "@toruslabs/eccrypto",
  "version": "7.0.0",
  "description": "JavaScript Elliptic curve cryptography library, includes fix to browser.js so that encrypt/decrypt works",
  "main": "./dist/lib.cjs/index.js",
  "module": "./dist/lib.esm/index.js",
  "types": "./dist/lib.cjs/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "vp pack",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test:ci": "npm run test:node && npm run test:browsers",
    "test:node": "vp test run --config test/configs/node.config.mts --coverage",
    "test:browsers": "vp test run --config test/configs/browsers.config.mts --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/torusresearch/eccrypto.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ecc",
    "ecdsa",
    "ecdh",
    "ecies",
    "crypto",
    "cryptography",
    "secp256k1",
    "K-256",
    "elliptic",
    "curve"
  ],
  "author": "Torus Labs",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/torusresearch/eccrypto/issues"
  },
  "homepage": "https://github.com/torusresearch/eccrypto",
  "devDependencies": {
    "@lavamoat/harden": "^0.8.1",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "9.0.1",
    "@types/node": "^25.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "buffer": "^6.0.3",
    "eccrypto-old": "npm:@toruslabs/eccrypto@6.2.0",
    "playwright": "^1.57.0",
    "typescript": "^7",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": false
  },
  "dependencies": {
    "@noble/curves": "^2.0.1"
  }
}
